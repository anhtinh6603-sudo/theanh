# --- LLM (Bot 2 Ideator, Bot 3 Writer, Bot 4 keyword extraction, Bot 5 script writer) ---
# At least one of these is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Bot 4 Image Gen ---
# "openai" (uses OPENAI_API_KEY above) or "leonardo" or "none" to skip image generation.
IMAGE_PROVIDER=openai
LEONARDO_API_KEY=

# --- Bot 1 Web Scraper ---
# Comma-separated RSS feed URLs. Defaults to a small set of VN + international news feeds if unset.
RSS_FEEDS=

# --- Bot 5 Video Render ---
# "edge" (free, no key needed) or "openai" (uses OPENAI_API_KEY, paid).
TTS_PROVIDER=edge
TTS_VOICE=vi-VN-HoaiMyNeural

# --- Bot 6 Auto-poster ---
# Path to a persistent Chrome/Chromium user-data-dir where you have already logged into
# your target platform by hand. The bot reuses this session — it never handles your
# password or bypasses login.
BROWSER_PROFILE_DIR=./data/browser-profile
# "golden hour" posting window, 24h local time, e.g. 19:00-21:00
PUBLISH_WINDOW_START=19:00
PUBLISH_WINDOW_END=21:00
