# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# ffmpeg-core is copied from node_modules by scripts/copy-ffmpeg-core.js (postinstall)
public/ffmpeg-core

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# SUBAGENT_HQ runtime state (không commit trạng thái job/log chạy thật)
# (mở lại thư mục logs/ vì rule "logs" ở trên chặn mọi thư mục tên "logs")
!SUBAGENT_HQ/logs/
!SUBAGENT_HQ/logs/.gitkeep
SUBAGENT_HQ/jobs/jobs.json
SUBAGENT_HQ/jobs/HALT
SUBAGENT_HQ/logs/*.jsonl
SUBAGENT_HQ/memory/profile.json
__pycache__/
